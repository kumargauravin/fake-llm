# Runtime connection strings (NOT in config files)
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key

BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# OR use SAS token
BLOB_SAS_TOKEN=?sv=2021-06-08&ss=b&srt=...

GCS_PROJECT_ID=your-project-id
GCS_KEY_FILE_PATH=./gcs-key.json

# Fallback LLM (optional)
FALLBACK_LLM_ENABLED=false
FALLBACK_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
FALLBACK_LLM_API_KEY=sk-...
FALLBACK_LLM_MODEL=gpt-4o-mini
